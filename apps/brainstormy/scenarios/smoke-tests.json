[
  {
    "id": "smoke-01-login",
    "name": "Login and Dashboard Load",
    "description": "Verify Clerk authentication and dashboard render",
    "mode": "smoke",
    "group": "independent",
    "order": 1,
    "steps": [
      {
        "action": "navigate",
        "params": { "path": "/" }
      }
    ],
    "assertions": [
      {
        "type": "element_exists",
        "selector": "userMenu",
        "message": "User menu should be visible after login"
      },
      {
        "type": "url_contains",
        "value": "/",
        "message": "Should be on the dashboard"
      }
    ]
  },
  {
    "id": "smoke-02-sidebar-loaded",
    "name": "Sidebar Loaded",
    "description": "Verify app sidebar renders after authentication",
    "mode": "smoke",
    "group": "independent",
    "order": 2,
    "steps": [
      {
        "action": "navigate",
        "params": { "path": "/" }
      }
    ],
    "assertions": [
      {
        "type": "element_exists",
        "selector": "sidebarProjects",
        "message": "Sidebar projects link should be visible"
      }
    ]
  }
]
